# ============================================================================
# ORPA PORTFOLIO — EXAMPLE ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Generate a secure password hash and session secret by running:
#   npm run hash-password
#
# NEVER commit `.env` or real production secrets to Git or GitHub.
# ============================================================================

PORT=3000
NODE_ENV=development

# Format: scrypt$16384$8$1$<salt_hex>$<derived_key_hex> (or Argon2id / bcrypt hash)
ADMIN_PASSWORD_HASH=replace_with_a_secure_password_hash

# Minimum 32-character cryptographically random hex or base64 string
SESSION_SECRET=replace_with_a_long_random_secret
